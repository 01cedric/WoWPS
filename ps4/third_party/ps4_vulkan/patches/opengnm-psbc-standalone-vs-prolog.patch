+/* Standalone PSBC does not own a complete RADV graphics-pipeline stage
+ * array, so it cannot call radv_link_shaders_info().  That link pass normally
+ * assigns every pre-raster output a hardware PARAM export.  Without the
+ * assignment, ACO still emits POS0 but silently drops generic varyings even
+ * though the container metadata advertises them.  A fragment shader then
+ * interpolates stale VGPR contents (observed as random atlas UVs on PS4).
+ *
+ * Mirror the explicit-output portion of radv_set_vs_output_param() here.  The
+ * standalone contract has no implicit consumer-driven PrimitiveId export;
+ * all declared per-vertex and per-primitive generic outputs retain the same
+ * ordering used by RADV's linker. */
+static void setup_standalone_prerast_output_params(
+    enum amd_gfx_level gfx_level, const nir_shader *nir,
+    struct radv_shader_info *info) {
+    struct radv_vs_output_info *outinfo = &info->outinfo;
+    const uint64_t special_mask =
+        VARYING_BIT_PRIMITIVE_COUNT |
+        VARYING_BIT_PRIMITIVE_INDICES |
+        VARYING_BIT_CULL_PRIMITIVE;
+    const uint64_t per_primitive =
+        nir->info.outputs_written & nir->info.per_primitive_outputs &
+        ~special_mask;
+    const uint64_t per_vertex =
+        nir->info.outputs_written & ~nir->info.per_primitive_outputs &
+        ~special_mask;
+
+    memset(outinfo->vs_output_param_offset, AC_EXP_PARAM_UNDEFINED,
+           sizeof(outinfo->vs_output_param_offset));
+
+    unsigned total = 0;
+    for (unsigned idx = 0; idx < 64 && idx < VARYING_SLOT_MAX; ++idx) {
+        if (!(per_vertex & (UINT64_C(1) << idx)))
+            continue;
+        if (idx >= VARYING_SLOT_VAR0 || idx == VARYING_SLOT_LAYER ||
+            idx == VARYING_SLOT_PRIMITIVE_ID ||
+            idx == VARYING_SLOT_VIEWPORT) {
+            outinfo->vs_output_param_offset[idx] = total++;
+        }
+    }
+    outinfo->param_exports = total;
+
+    const unsigned primitive_base =
+        total == 0 && gfx_level >= GFX11 ? 1 : 0;
+    for (unsigned idx = 0; idx < 64 && idx < VARYING_SLOT_MAX; ++idx) {
+        if (!(per_primitive & (UINT64_C(1) << idx)))
+            continue;
+        if (idx >= VARYING_SLOT_VAR0 || idx == VARYING_SLOT_LAYER ||
+            idx == VARYING_SLOT_PRIMITIVE_ID ||
+            idx == VARYING_SLOT_VIEWPORT) {
+            outinfo->vs_output_param_offset[idx] = primitive_base + total++;
+        }
+    }
+    outinfo->prim_param_exports = total - outinfo->param_exports;
+}
